pipeline {
    agent {
        kubernetes {
            yamlFile 'k8s/jenkins/node-agent.yaml'
            defaultContainer 'node'
            retries 1
        }
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        APP_DIR = 'cicd-api'
        IMAGE_NAME = 'cicd-api'
        CI = 'true'
        NPM_CONFIG_CACHE = "${WORKSPACE}/.npm"
    }

    stages {
        // O checkout do repositório já é feito automaticamente pelo Declarative Pipeline

        stage('Info') {
            steps {
                dir(env.APP_DIR) {
                    sh 'node --version && npm --version'
                }
                echo "Branch: ${env.GIT_BRANCH}"
            }
        }

        stage('Install') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm run lint --if-present'
                }
            }
        }

        stage('Syntax check') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        node --check src/server.js
                        node --check src/models/models.js
                        node --check src/docs/swagger.js
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mkdir -p reports && npm run test:ci'
                }
            }
            post {
                always {
                    dir(env.APP_DIR) {
                        junit allowEmptyResults: true, testResults: 'reports/junit.xml'
                    }
                }
            }
        }

        stage('Security audit') {
            steps {
                dir(env.APP_DIR) {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh 'npm audit --omit=dev --audit-level=high'
                    }
                }
            }
        }

        stage('Build image') {
            steps {
                container(name: 'kaniko', shell: '/busybox/sh') {
                    sh '''
                        /kaniko/executor \
                            --context "dir://${WORKSPACE}/${APP_DIR}" \
                            --dockerfile "${WORKSPACE}/${APP_DIR}/Dockerfile" \
                            --destination "${IMAGE_NAME}:${BUILD_NUMBER}" \
                            --no-push
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline concluído com sucesso.'
        }
        failure {
            echo 'Pipeline falhou. Verifique os logs do stage com erro.'
        }
        // Sem cleanWs(): o pod do agente é descartado ao fim do build
    }
}