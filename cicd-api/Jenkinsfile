pipeline {
    agent {
        kubernetes {
            yamlFile 'k8s/jenkins/node-agent.yaml'
            defaultContainer 'node'
            retries 1
        }
    }

    options {
        timestamps()
        // Build + download da base de dados do Trivy + scan levam mais tempo
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        APP_DIR = 'cicd-api'
        // Repositório da imagem definido em um só lugar (usado pelo Kaniko e pelo Trivy)
        IMAGE_REPO = 'docker.io/andersoncrms/cicd-api'
        CI = 'true'
        NPM_CONFIG_CACHE = "${WORKSPACE}/.npm"
    }

    stages {
        // O checkout do repositório já é feito automaticamente pelo Declarative Pipeline

        stage('Info') {
            steps {
                dir(env.APP_DIR) {
                    sh 'node --version && npm --version'
                }
                echo "Branch: ${env.GIT_BRANCH}"
            }
        }

        stage('Install') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm run lint --if-present'
                }
            }
        }

        stage('Syntax check') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        node --check src/server.js
                        node --check src/models/models.js
                        node --check src/docs/swagger.js
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mkdir -p reports && npm run test:ci'
                }
            }
            post {
                always {
                    dir(env.APP_DIR) {
                        junit allowEmptyResults: true, testResults: 'reports/junit.xml'
                    }
                }
            }
        }

        stage('Security audit') {
            steps {
                dir(env.APP_DIR) {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh 'npm audit --omit=dev --audit-level=high'
                    }
                }
            }
        }

        stage('Build and Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    container(name: 'kaniko', shell: '/busybox/sh') {
                        sh '''
                            set -eu
                            set +x

                            USER_CLEAN="$(printf '%s' "$DOCKERHUB_USER" | tr -d '[:space:]')"
                            TOKEN_CLEAN="$(printf '%s' "$DOCKERHUB_TOKEN" | tr -d '[:space:]')"

                            AUTH="$(printf '%s:%s' "$USER_CLEAN" "$TOKEN_CLEAN" | base64 | tr -d '\\n')"

                            echo "Gerando credenciais do Docker Hub para o Kaniko..."
                            mkdir -p /kaniko/.docker
                            printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' "$AUTH" > /kaniko/.docker/config.json
                            chmod 600 /kaniko/.docker/config.json

                            echo "Construindo e publicando a imagem..."

                            /kaniko/executor \
                                --context "dir://${WORKSPACE}/${APP_DIR}" \
                                --dockerfile "${WORKSPACE}/${APP_DIR}/Dockerfile" \
                                --destination "${IMAGE_REPO}:${BUILD_NUMBER}" \
                                --destination "${IMAGE_REPO}:latest"

                            echo "Imagem publicada:"
                            echo "${IMAGE_REPO}:${BUILD_NUMBER}"
                            echo "${IMAGE_REPO}:latest"
                        '''
                    }
                }
            }
        }

        stage('Scan image with Trivy') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            usernameVariable: 'DOCKERHUB_USER',
                            passwordVariable: 'DOCKERHUB_TOKEN'
                        )
                    ]) {
                        container(name: 'trivy', shell: '/bin/sh') {
                            sh '''
                                set -eu
                                set +x

                                export TRIVY_USERNAME="$DOCKERHUB_USER"
                                export TRIVY_PASSWORD="$DOCKERHUB_TOKEN"

                                echo "Analisando imagem: ${IMAGE_REPO}:${BUILD_NUMBER}"

                                trivy image \
                                    --scanners vuln \
                                    --severity HIGH,CRITICAL \
                                    --ignore-unfixed \
                                    --exit-code 1 \
                                    --timeout 10m \
                                    --no-progress \
                                    "${IMAGE_REPO}:${BUILD_NUMBER}"
                            '''
                        }
                    }
                }
            }
        }

        stage('Update GitOps manifest') {
            when {
                expression { env.GIT_BRANCH == 'origin/main' }
            }
            steps {
                withCredentials([gitUsernamePassword(credentialsId: 'github-creds')]) {
                    container('jnlp') {
                        sh '''
                            set -eu

                            MANIFEST="k8s/api/deployment.yaml"

                            git config --global --add safe.directory "${WORKSPACE}"
                            git config user.name "jenkins-ci"
                            git config user.email "jenkins-ci@localhost"

                            sed -i "s|image: andersoncrms/cicd-api:.*|image: andersoncrms/cicd-api:${BUILD_NUMBER}|" "$MANIFEST"
                            grep -q "image: andersoncrms/cicd-api:${BUILD_NUMBER}" "$MANIFEST"

                            git add "$MANIFEST"
                            git commit -m "ci: deploy cicd-api image ${BUILD_NUMBER}"

                            git fetch origin main
                            git rebase origin/main
                            git push origin HEAD:main
                        '''
                    }
                }
            }
        }

        stage('CI Summary') {
            steps {
                script {
                    echo """
                    ==================================================
                              CI PIPELINE SUMMARY
                    ==================================================
                    Job:             ${env.JOB_NAME}
                    Build number:    #${env.BUILD_NUMBER}
                    Build result:    ${currentBuild.currentResult}
                    Branch:          ${env.GIT_BRANCH ?: 'unknown'}
                    Commit:          ${env.GIT_COMMIT ?: 'unknown'}
                    Repository:      ${env.GIT_URL ?: 'unknown'}
                    Build URL:       ${env.BUILD_URL ?: 'unknown'}

                    Application:     ${env.APP_DIR}
                    Docker image:    ${env.IMAGE_REPO}
                    Versioned tag:   ${env.IMAGE_REPO}:${env.BUILD_NUMBER}
                    Latest tag:      ${env.IMAGE_REPO}:latest
                    ==================================================
                    """
                }

                dir(env.APP_DIR) {
                    sh '''
                        set +e

                        echo ""
                        echo "========== NODE.JS =========="
                        node --version
                        npm --version

                        echo ""
                        echo "========== APPLICATION =========="
                        node -p "'Name: ' + require('./package.json').name"
                        node -p "'Version: ' + require('./package.json').version"

                        echo ""
                        echo "========== DOCKERFILE =========="
                        if [ -f Dockerfile ]; then
                            echo "Dockerfile encontrado."
                            sha256sum Dockerfile 2>/dev/null || true
                        else
                            echo "ERRO: Dockerfile não encontrado!"
                        fi

                        echo ""
                        echo "========== KUBERNETES MANIFEST =========="

                        MANIFEST="$WORKSPACE/k8s/api/deployment.yaml"

                        if [ -f "$MANIFEST" ]; then
                            echo "Manifesto: $MANIFEST"
                            grep -nE '^[[:space:]]*(image:|imagePullPolicy:)' "$MANIFEST"
                        else
                            echo "ERRO: manifesto não encontrado em $MANIFEST"
                        fi

                        echo ""
                        echo "========== SUMMARY FINISHED =========="
                    '''
                }
            }
        }

    }

    post {
        success {
            echo 'Pipeline concluído com sucesso.'
        }
        failure {
            echo 'Pipeline falhou. Verifique os logs do stage com erro.'
        }
        // Sem cleanWs(): o pod do agente é descartado ao fim do build
    }
}